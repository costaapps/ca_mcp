    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.4"
