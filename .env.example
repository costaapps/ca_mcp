PORT=3102
NODE_ENV=development

# Registry central: user dedicated to read company/database descriptors.
CENTRAL_DB_HOST=
CENTRAL_DB_PORT=3306
CENTRAL_DB_NAME=
CENTRAL_DB_USER=
CENTRAL_DB_PASS=
CENTRAL_DB_CONNECTION_LIMIT=4
CENTRAL_REGISTRY_CACHE_MS=60000

# Tenant pools are shared by IdDatabase within this process.
TENANT_DB_CONNECTION_LIMIT=8
TENANT_DB_CONNECT_TIMEOUT_MS=10000
TENANT_DB_MAX_POOLS=32
TENANT_DB_IDLE_TTL_MS=300000

# Core endpoint is resolved from each company's GeneralSettings.
CORE_API_TIMEOUT_MS=60000
MCP_CORE_SETTINGS_CACHE_MS=60000

# Comma-separated CompanyUUID values served by this installation.
# Required and non-empty when NODE_ENV=production.
MCP_TENANT_ALLOWLIST=
MCP_SHUTDOWN_TIMEOUT_MS=75000
MCP_IMAGE=eduardomatuellacostaapps/ca:mcp-0.2.2
